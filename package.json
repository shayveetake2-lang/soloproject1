{
  "name": "veloce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "set -a && . ./.env && set +a && ./.venv/bin/python server.py",
    "setup:python": "./.venv/bin/python -m pip install -r requirements.txt",
    "build": "vite build",
    "check": "npm run build && ./.venv/bin/python -m py_compile server.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
